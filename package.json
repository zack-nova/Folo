{
  "name": "@follow/monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "description": "Follow everything in one place",
  "author": "Folo Team",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/RSSNext",
  "repository": {
    "url": "https://github.com/RSSNext/follow",
    "type": "git"
  },
  "scripts": {
    "build:packages": "turbo run build --filter=\"./packages/**/*\"",
    "build:web": "turbo run Folo#build:web",
    "contracts:check": "pnpm --filter @follow/compat-contracts test",
    "contracts:update": "pnpm --filter @follow/compat-contracts contracts:update",
    "dedupe:locales": "eslint --fix locales/**",
    "depcheck": "npx depcheck --quiet",
    "dev:web": "turbo run @follow/web#dev @follow/ssr#dev",
    "dev:self-hosted": "pnpm server:db:up && cross-env DATABASE_URL=postgres://folo:folo@localhost:54329/folo BETTER_AUTH_SECRET=local-development-secret-at-least-32-characters SERVER_URL=http://localhost:3000 CLIENT_ORIGINS=http://localhost:2233 VITE_API_URL=http://localhost:3000 VITE_WEB_URL=http://localhost:2233 turbo run @follow/server#dev @follow/web#dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:sync": "tsx scripts/svg-to-rn.ts && prettier --write apps/mobile/src/icons/**/*.tsx && eslint --fix apps/mobile/src/icons/**/*.tsx",
    "icons:update": "tsx scripts/update-icon.ts",
    "lint": "pnpm run lint:tsl && eslint",
    "lint:fix": "eslint --fix",
    "lint:tsl": "tsslint --project apps/*/tsconfig.json",
    "mitproxy": "bash scripts/run-proxy.sh",
    "polyfill-optimize": "pnpx nolyfill install",
    "postinstall": "pnpm run build:packages",
    "prepare": "simple-git-hooks && corepack prepare",
    "reinstall": "rm -rf node_modules && rm -rf apps/**/node_modules && rm -rf packages/**/node_modules && pnpm install",
    "test": "cross-env CI=1 pnpm --recursive run test",
    "server:db:down": "docker compose -f apps/server/compose.yaml down",
    "server:db:up": "docker compose -f apps/server/compose.yaml up -d --wait",
    "server:backup": "bash apps/server/scripts/backup.sh",
    "server:migrate": "pnpm --filter @follow/server db:migrate",
    "server:e2e:web": "pnpm --dir apps/desktop e2e:self-hosted",
    "server:restore:drill": "bash apps/server/scripts/restore-drill.sh",
    "server:test:postgres": "cross-env TEST_DATABASE_URL=postgres://folo:folo@localhost:54329/folo pnpm --filter @follow/server test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@eslint/compat": "2.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsslint/cli": "3.1.4",
    "@tsslint/compat-eslint": "3.1.4",
    "@tsslint/config": "3.1.4",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vercel/node": "5.8.22",
    "cross-env": "10.1.0",
    "eslint": "10.6.0",
    "eslint-config-hyoban": "7.0.3",
    "eslint-plugin-react-native": "5.0.0",
    "fast-glob": "3.3.3",
    "glob": "13.0.6",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "raw-body": "3.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "6.1.3",
    "simple-git-hooks": "2.13.1",
    "svg-parser": "2.0.4",
    "tar": "7.5.19",
    "tsl": "1.0.30",
    "tsx": "4.23.0",
    "turbo": "2.10.4",
    "typescript": "catalog:",
    "vite": "7.3.1",
    "vitest": "4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --ignore-unknown --write"
    ],
    "apps/mobile/src/**/*": [
      "bash scripts/increment-build-id.sh"
    ],
    "locales/**/*.json": [
      "npm run dedupe:locales",
      "git add locales"
    ]
  }
}
