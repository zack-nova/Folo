BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AI_ENCRYPTION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
METRICS_TOKEN=replace-with-a-third-random-secret-of-at-least-32-characters

# Public URLs must terminate TLS at a reverse proxy. The production Compose file only binds the
# API to 127.0.0.1 by default.
SERVER_URL=https://api.reader.example.com
CLIENT_ORIGINS=https://reader.example.com
TRUST_PROXY_HOPS=1

ALLOW_PUBLIC_REGISTRATION=false
ALLOW_PRIVATE_FEEDS=false
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

FEED_POLL_CONCURRENCY=4
FEED_POLL_INTERVAL_MS=900000
FEED_RETRY_BASE_DELAY_MS=60000
FEED_FETCH_TIMEOUT_MS=15000
FEED_FETCH_MAX_BYTES=5242880

AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_MS=60000

PROCESSING_WORKER_POLL_INTERVAL_MS=1000
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_DELAY_MS=1000

# Compose interpolation also reads this value. Use a URL-safe password because it is embedded in
# DATABASE_URL. Generate one with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
