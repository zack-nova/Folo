BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AI_ENCRYPTION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
METRICS_TOKEN=replace-with-a-third-random-secret-of-at-least-32-characters

# Public URLs must terminate TLS at a reverse proxy. The production Compose file only binds the
# API to 127.0.0.1 by default.
SERVER_URL=https://api.reader.example.com
CLIENT_ORIGINS=https://reader.example.com
# Reverse proxies whose X-Forwarded-For is trusted: IPs, CIDR ranges, or loopback / linklocal /
# uniquelocal. The host proxy reaches the container through the Docker bridge (a private range).
TRUST_PROXY=loopback,uniquelocal

ALLOW_PUBLIC_REGISTRATION=false
ALLOW_PRIVATE_FEEDS=false
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

FEED_POLL_CONCURRENCY=4
FEED_POLL_INTERVAL_MS=900000
FEED_RETRY_BASE_DELAY_MS=60000
FEED_FETCH_TIMEOUT_MS=15000
FEED_FETCH_MAX_BYTES=5242880

# Optional external supplier. Use http://feed-supplier:3001 with the same-host Compose overlay,
# or a private-network/tunnel URL for a separate host. Both values must be set together.
# FEED_SUPPLIER_URL=http://feed-supplier:3001
# FEED_SUPPLIER_TOKEN=replace-with-a-fourth-independent-random-secret
# Optional: lets the instance owner manage web list sources in Settings → Sources. It must
# differ from every other secret; the supplier reads the same value as MANAGEMENT_TOKEN.
# FEED_SUPPLIER_MANAGEMENT_TOKEN=replace-with-a-fifth-independent-random-secret
# Keep RSSHub, source database, admin, encryption, and audit secrets in the separate
# apps/feed-supplier/.env.production file. The API container must not receive them.

# Optional: the owner's Codex CLI (ChatGPT plan) as a low-volume provider. Leave unset to disable.
# AI_CODEX_COMMAND=/usr/local/bin/codex
# AI_CODEX_SCOPE=manual            # manual: owner-triggered re-evaluations only; all: every job
# AI_CODEX_DAILY_LIMIT=200
# AI_CODEX_MODEL=
# AI_CODEX_REASONING_EFFORT=low   # minimal | low | medium | high | xhigh; model default when unset
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_MS=60000

PROCESSING_WORKER_POLL_INTERVAL_MS=1000
PROCESSING_MAX_ATTEMPTS=3
# Characters of plain entry text sent per AI evaluation (markup is removed first).
PROCESSING_MAX_CONTENT_CHARS=12000
# Automatic evaluations per provider call (1 = one entry per call) and the plain-text budget of a batch.
PROCESSING_BATCH_SIZE=10
PROCESSING_BATCH_MAX_CHARS=40000
PROCESSING_RETRY_BASE_DELAY_MS=1000

# Compose interpolation also reads this value. Use a URL-safe password because it is embedded in
# DATABASE_URL. Generate one with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
