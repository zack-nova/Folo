DATABASE_URL=postgres://folo:folo@localhost:54329/folo
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SERVER_URL=http://localhost:3000
CLIENT_ORIGINS=http://localhost:2233
HOST=0.0.0.0
PORT=3000

# Poll subscribed feeds every 15 minutes.
FEED_POLL_INTERVAL_MS=900000
FEED_FETCH_TIMEOUT_MS=15000
FEED_FETCH_MAX_BYTES=5242880

# Enable only when you intentionally subscribe to LAN-only RSS sources.
ALLOW_PRIVATE_FEEDS=false
