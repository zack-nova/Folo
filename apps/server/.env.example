DATABASE_URL=postgres://folo:folo@localhost:54329/folo
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SERVER_URL=http://localhost:3000
CLIENT_ORIGINS=http://localhost:2233
HOST=0.0.0.0
PORT=3000
UPLOADS_DIRECTORY=./data/uploads
TRUST_PROXY_HOPS=0

# Production requires this token. Prometheus must send Authorization: Bearer <token>.
# METRICS_TOKEN=replace-with-at-least-32-random-characters

# Per-IP limits per minute. Authentication mutations use the stricter second limit.
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# Single-owner instances close registration after the first account by default.
ALLOW_PUBLIC_REGISTRATION=false

# Poll subscribed feeds every 15 minutes.
FEED_POLL_CONCURRENCY=4
FEED_POLL_INTERVAL_MS=900000
FEED_RETRY_BASE_DELAY_MS=60000
FEED_FETCH_TIMEOUT_MS=15000
FEED_FETCH_MAX_BYTES=5242880

# Enable only when you intentionally subscribe to LAN-only RSS sources.
ALLOW_PRIVATE_FEEDS=false

# Emergency-only production override for deployments without TLS. Leave false normally.
ALLOW_INSECURE_HTTP=false

# Optional environment-owned OpenAI-compatible provider. You can instead configure BYOK through
# /api/extensions/ai/provider after signing in. Environment values are never returned by the API.
# AI_API_KEY=replace-with-your-provider-key
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_MS=60000

# Defaults to BETTER_AUTH_SECRET. Set a separate stable 32+ character secret in production.
# Changing this value makes stored BYOK credentials unreadable.
# AI_ENCRYPTION_SECRET=replace-with-an-independent-32-character-secret

PROCESSING_WORKER_POLL_INTERVAL_MS=1000
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_DELAY_MS=1000
