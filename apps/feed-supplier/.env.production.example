# Supply FEED_SUPPLIER_TOKEN through the main API environment file as well.
FEED_SUPPLIER_ADMIN_TOKEN=replace-with-an-independent-32-character-admin-token
FEED_SUPPLIER_DATABASE_URL=postgresql://feed_supplier:url-encoded-password@feed-supplier-postgres:5432/feed_supplier
FEED_SUPPLIER_POSTGRES_PASSWORD=replace-with-an-independent-database-password
FEED_SUPPLIER_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-output-of-openssl-rand-32
FEED_SUPPLIER_CREDENTIAL_ENCRYPTION_KEY_ID=primary-2026-08
FEED_SUPPLIER_CREDENTIAL_DECRYPTION_KEYS_JSON={}
FEED_SUPPLIER_AUDIT_HMAC_KEY=replace-with-a-different-base64-output-of-openssl-rand-32
FEED_SUPPLIER_REGISTRY_MODE=permissive
RSSHUB_ACCESS_KEY=replace-with-an-independent-rsshub-access-key
RSSHUB_IMAGE=diygod/rsshub@sha256:replace-with-a-verified-digest
