{
  "description": "Web list sources migrated from the Feeds Agent supplier configuration (config/supplier/sources). Import with scripts/import-web-list-sources.ts.",
  "defaults": {
    "intervalMinutes": 360
  },
  "sources": [
    {
      "key": "aihot-items",
      "description": "AI HOT 精选条目。旧 /api/public/feed 已于 2026-09-28 停用，改用公开 API v1。",
      "source": {
        "name": "AI HOT 精选",
        "targetURL": "https://aihot.news/api/v1/items?limit=50",
        "maxItems": 50,
        "timeZone": "UTC",
        "detail": {
          "enabled": false
        },
        "format": "json",
        "json": {
          "itemsPath": "items",
          "titlePath": "title",
          "urlPath": "links.aihot",
          "idPath": "id",
          "summaryPath": "summary",
          "publishedAtPath": "publishedAt",
          "metadataPaths": {
            "来源": "source.name",
            "原文": "links.original",
            "分类": "category"
          }
        }
      }
    },
    {
      "key": "china-gov-latest-policy-json",
      "description": "国务院及部门最新政策聚合 JSON，用于国家级政策查漏。",
      "source": {
        "name": "中国政府网最新政策",
        "targetURL": "https://www.gov.cn/zhengce/zuixin/ZUIXINZHENGCE.json",
        "maxItems": 25,
        "timeZone": "Asia/Shanghai",
        "detail": {
          "enabled": true,
          "contentSelectors": ["#UCAP-CONTENT"]
        },
        "format": "json",
        "json": {
          "itemsPath": "",
          "titlePath": "TITLE",
          "urlPath": "URL",
          "publishedAtPath": "DOCRELPUBTIME",
          "metadataPaths": {
            "副标题": "SUB_TITLE"
          }
        }
      }
    },
    {
      "key": "miit-policy-documents-json",
      "description": "工信部政务公开政策文件“文件发布”分类搜索 API。",
      "source": {
        "name": "工业和信息化部文件发布",
        "targetURL": "https://www.miit.gov.cn/search-front-server/api/search/info?websiteid=110000000000000&scope=basic&q=&pg=10&cateid=58&pos=title_text%2Cinfocontent%2Ctitlepy&_cus_eq_typename=&_cus_eq_publishgroupname=&_cus_eq_themename=&begin=&end=&dateField=deploytime&selectFields=title%2Ccontent%2Cdeploytime%2C_index%2Curl%2Ccdate%2Cinfoextends%2Cinfocontentattribute%2Ccolumnname%2Cfilenumbername%2Cpublishgroupname%2Cpublishtime%2Cmetaid%2Cbexxgk%2Ccolumnid%2Cxxgkextend1%2Cxxgkextend2%2Cthemename%2Ctypename%2Cindexcode%2Ccreatedate&group=distinct&highlightConfigs=%5B%7B%22field%22%3A%22infocontent%22%2C%22numberOfFragments%22%3A2%2C%22fragmentOffset%22%3A0%2C%22fragmentSize%22%3A30%2C%22noMatchSize%22%3A145%7D%5D&highlightFields=title_text%2Cinfocontent%2Cwebid&level=6&sortFields=%5B%7B%22name%22%3A%22deploytime%22%2C%22type%22%3A%22desc%22%7D%5D&p=1",
        "maxItems": 20,
        "timeZone": "Asia/Shanghai",
        "detail": {
          "enabled": true,
          "contentSelectors": ["#con_con", ".ccontent"]
        },
        "format": "json",
        "json": {
          "itemsPath": "data.searchResult.dataResults[].groupData[0].data",
          "titlePath": "title",
          "urlPath": "url",
          "publishedAtPath": "deploytime",
          "publishedAtFormat": "unix_milliseconds",
          "metadataPaths": {
            "文号": "filenumbername",
            "发文机关": "publishgroupname",
            "文件类型": "typename",
            "主题": "themename",
            "栏目": "columnname"
          }
        }
      }
    },
    {
      "key": "miit-sme-platform-notices-json",
