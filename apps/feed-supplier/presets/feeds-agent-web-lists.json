        "json": {
          "itemsPath": "json.tzggList",
          "titlePath": "title",
          "urlTemplate": "https://zjtx.miit.gov.cn/zxqySy/tzggView?id={id}",
          "publishedAtPath": "fbsj",
          "idPath": "id",
          "metadataPaths": {
            "通知类型": "fblx",
            "发布单位": "llrjgmc"
          }
        }
      }
    },
