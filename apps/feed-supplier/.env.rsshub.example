# Copy to apps/feed-supplier/.env.rsshub (or point RSSHUB_ENV_FILE elsewhere) and keep only the
# lines you fill in: RSSHub treats an empty value as configured. These credentials stay inside the
# RSSHub container; neither the Folo core nor feed-supplier reads them.
# Full list: https://docs.rsshub.app/deploy/config#route-specific-configurations

# X / Twitter user timelines (twitter-user catalog route): the auth_token cookie of a logged-in
# account. Several tokens may be comma-separated.
TWITTER_AUTH_TOKEN=

# Zhihu: a d_c0 and __zse_ck cookie pair makes zhihu-hot more reliable.
ZHIHU_COOKIES=

# Bilibili video search: BILIBILI_COOKIE_<uid>=<cookie of that logged-in user>.
BILIBILI_COOKIE_0000000=

# Weibo hot search (also needs the chromium-bundled RSSHub image).
WEIBO_COOKIES=

# GitHub trending and starred repositories.
GITHUB_ACCESS_TOKEN=
